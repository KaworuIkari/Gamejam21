[ext_resource type="PackedScene" path="res://ui/settings/settings_menu.tscn" id="2_settings"]

[ext_resource type="Script" path="res://ui/theme/light/pause_light_style.gd" id="5_light"]

[ext_resource type="Theme" path="res://ui/theme/light/light_theme.tres" id="light_theme"]

[node name="PauseMenu" type="CanvasLayer"]
layer = 100
process_mode = 3
