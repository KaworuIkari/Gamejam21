restrict_height = true
reference_frame = 1

[sub_resource type="Resource" id="Resource_randomize"]
script = ExtResource("randomize")
position = Vector3(0.15, 0, 0.15)
rotation = Vector3(10, 360, 10)
scale = Vector3(0.6, 0.6, 0.6)
